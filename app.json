{
  "expo": {
    "name": "ToBump",
    "slug": "tobump-mobile",
    "version": "1.0.0",
    "orientation": "portrait",
    "icon": "./assets/images/icon.png",
    "scheme": "tobump",
    "userInterfaceStyle": "light",
    "ios": {
      "supportsTablet": true,
      "bundleIdentifier": "com.tobump.mobile",
      "infoPlist": {
        "NSPhotoLibraryUsageDescription": "Used to upload your profile photo.",
        "NSLocationWhenInUseUsageDescription": "Used to set your profile location and find nearby venues."
      }
    },
    "android": {
      "adaptiveIcon": {
        "backgroundColor": "#0B6E4F",
        "foregroundImage": "./assets/images/android-icon-foreground.png",
        "backgroundImage": "./assets/images/android-icon-background.png",
        "monochromeImage": "./assets/images/android-icon-monochrome.png"
      },
      "package": "com.tobump.mobile",
      "permissions": [
        "android.permission.NOTIFICATIONS",
        "android.permission.RECORD_AUDIO",
        "android.permission.ACCESS_COARSE_LOCATION",
        "android.permission.ACCESS_FINE_LOCATION"
      ]
    },
    "web": {
      "bundler": "metro",
      "output": "static",
      "favicon": "./assets/images/favicon.png"
    },
    "plugins": [
      "expo-router",
      "expo-secure-store",
      [
        "expo-splash-screen",
        {
          "image": "./assets/images/splash-icon.png",
          "resizeMode": "contain",
          "backgroundColor": "#0B6E4F"
        }
      ],
      [
        "expo-notifications",
        {
          "color": "#0B6E4F"
        }
      ],
      [
        "expo-image-picker",
        {
          "photosPermission": "Used to upload your profile photo."
        }
      ],
      [
        "expo-location",
        {
          "locationWhenInUsePermission": "Used to set your profile location and find nearby venues."
        }
      ]
    ],
    "experiments": {
      "typedRoutes": true
    },
    "extra": {
      "router": {},
      "eas": {
        "projectId": "76fd313c-16db-4b36-a204-c5cd341e0154"
      }
    },
    "owner": "tobump"
  }
}
